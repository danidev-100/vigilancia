// ============================================================
// Vigilancia — Private Neighborhood Security Management System
// Prisma Schema v1.0
// ============================================================

generator client {
  provider        = "prisma-client-js"
  engineType      = "binary"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  SECURITY_GUARD
  PROPERTY_OWNER
}

enum VisitorType {
  ONE_TIME
  SCHEDULED
  PERMANENT
}

enum EntryMethod {
  QR_CODE
  NATIONAL_ID
  NAME
  VEHICLE_PLATE
  MANUAL
}

enum IncidentType {
  SUSPICIOUS_ACTIVITY
  VEHICLE_DAMAGE
  LOST_ITEMS
  EMERGENCY
  OTHER
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
}

enum PersonType {
  VISITOR
  EMPLOYEE
  CONTRACTOR
  FAMILY_MEMBER
  RESIDENT
}

enum NotificationType {
  VISITOR_ARRIVAL
  VISITOR_DEPARTURE
  EMPLOYEE_ARRIVAL
  EMPLOYEE_DEPARTURE
  AUTHORIZATION_REQUEST
  AUTHORIZATION_APPROVED
  AUTHORIZATION_CANCELLED
  INCIDENT_REPORTED
  SYSTEM_ALERT
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

// ============================================================
// MODELS
// ============================================================

// ---- AUTH & USERS ----

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String?        // nullable for OAuth-only accounts
  name          String
  phone         String?
  role          Role           @default(PROPERTY_OWNER)
  photo         String?
  emailVerified Boolean        @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  ownedProperties Property[]
  authorizedVisitors Visitor[]      @relation("AuthorizedBy")
  entriesAsGuard   Entry[]          @relation("GuardEntry")
  incidents        Incident[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]
  accounts         Account[]
  sessions         Session[]

  @@index([email])
  @@index([role])
  @@index([name])
  @@map("users")
}

model Account {
  id                String       @id @default(uuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         DateTime?
  createdAt         DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model VerificationToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  type       String   // "EMAIL_VERIFICATION" | "PASSWORD_RESET"
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("verification_tokens")
}

// ---- PROPERTIES ----

model Property {
  id           String         @id @default(uuid())
  ownerId      String
  houseNumber  String
  block        String
  street       String
  neighborhood String
  status       PropertyStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relations
  owner            User             @relation(fields: [ownerId], references: [id])
  familyMembers    FamilyMember[]
  visitors         Visitor[]
  employees        Employee[]
  contractors      Contractor[]
  vehicles         Vehicle[]
  entries          Entry[]

  @@index([ownerId])
  @@index([houseNumber, block, street])
  @@index([neighborhood])
  @@map("properties")
}

// ---- FAMILY MEMBERS ----

model FamilyMember {
  id           String   @id @default(uuid())
  propertyId   String
  fullName     String
  nationalId   String?
  phone        String
  relationship String   // "SPOUSE" | "CHILD" | "PARENT" | "SIBLING" | "OTHER"
  photo        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  entries   Entry[]

  @@index([propertyId])
  @@index([fullName])
  @@index([nationalId])
  @@map("family_members")
}

// ---- VISITORS ----

model Visitor {
  id             String      @id @default(uuid())
  propertyId     String
  fullName       String
  document       String?     // National ID or Passport
  phone          String?
  email          String?
  vehiclePlate   String?
  vehicleBrand   String?
  vehicleModel   String?
  photo          String?
  notes          String?
  authorizedById String
  visitorType    VisitorType @default(ONE_TIME)
  validFrom      DateTime
  validUntil     DateTime
  qrCode         String?     @unique
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authorizedBy User     @relation("AuthorizedBy", fields: [authorizedById], references: [id])
  entries      Entry[]

  @@index([propertyId])
  @@index([fullName])
  @@index([document])
  @@index([phone])
  @@index([vehiclePlate])
  @@index([validFrom, validUntil])
  @@index([qrCode])
  @@map("visitors")
}

// ---- EMPLOYEES ----

model Employee {
  id           String   @id @default(uuid())
  propertyId   String
  fullName     String
  nationalId   String?
  phone        String
  position     String
  company      String
  vehiclePlate String?
  workSchedule String?   // JSON string for flexible scheduling
  photo        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  entries  Entry[]

  @@index([propertyId])
  @@index([fullName])
  @@index([nationalId])
  @@index([company])
  @@index([phone])
  @@map("employees")
}

// ---- CONTRACTORS ----

model Contractor {
  id              String   @id @default(uuid())
  propertyId      String
  company         String
  employeeName    String
  nationalId      String?
  phone           String?
  vehiclePlate    String?
  vehicleBrand    String?
  vehicleModel    String?
  serviceType     String
  workOrder       String?
  authorizedUntil DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  entries  Entry[]

  @@index([propertyId])
  @@index([company])
  @@index([employeeName])
  @@map("contractors")
}

// ---- VEHICLES ----

model Vehicle {
  id          String    @id @default(uuid())
  plate       String
  brand       String
  model       String
  color       String?
  ownerType   PersonType
  propertyId  String?
  ownerId     String?   // Polymorphic: familyMemberId, visitorId, etc.
  familyMemberId String? // Direct FK for family member vehicles
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  property     Property?     @relation(fields: [propertyId], references: [id])
  familyMember FamilyMember? @relation(fields: [familyMemberId], references: [id])

  @@unique([plate, ownerType, ownerId])
  @@index([plate])
  @@index([propertyId])
  @@index([familyMemberId])
  @@map("vehicles")
}

// ---- ENTRIES (Entry/Exit Control) ----

model Entry {
  id             String      @id @default(uuid())
  personType     PersonType
  visitorId      String?
  employeeId     String?
  contractorId   String?
  familyMemberId String?
  guardId        String
  propertyId     String?
  gate           String
  entryTime      DateTime    @default(now())
  exitTime       DateTime?
  entryMethod    EntryMethod @default(MANUAL)
  photo          String?
  notes          String?
  createdAt      DateTime    @default(now())

  // Relations
  guard        User        @relation("GuardEntry", fields: [guardId], references: [id])
  property     Property?   @relation(fields: [propertyId], references: [id])
  visitor      Visitor?    @relation(fields: [visitorId], references: [id])
  employee     Employee?   @relation(fields: [employeeId], references: [id])
  contractor   Contractor? @relation(fields: [contractorId], references: [id])
  familyMember FamilyMember? @relation(fields: [familyMemberId], references: [id])

  @@index([guardId])
  @@index([propertyId])
  @@index([visitorId])
  @@index([employeeId])
  @@index([entryTime])
  @@index([exitTime])
  @@index([gate])
  @@index([personType])
  @@map("entries")
}

// ---- INCIDENTS ----

model Incident {
  id          String       @id @default(uuid())
  guardId     String
  title       String
  description String
  incidentType IncidentType @default(OTHER)
  photos      String[]     // Cloudinary URLs
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  guard User @relation(fields: [guardId], references: [id])

  @@index([guardId])
  @@index([incidentType])
  @@index([createdAt])
  @@map("incidents")
}

// ---- NOTIFICATIONS ----

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  data      Json?            // Additional context payload
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ---- AUDIT LOG ----

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // "LOGIN" | "LOGOUT" | "VISITOR_CREATED" | etc.
  entityType String   // "USER" | "VISITOR" | "EMPLOYEE" | etc.
  entityId   String?
  details    Json?    // Changes, metadata
  ipAddress  String?
  createdAt  DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
